generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Platform Level ───────────────────────────────────────────────────────────

model Plan {
  id            String    @id @default(cuid())
  name          String
  price         Float
  maxUnits      Int
  maxTenants    Int
  maxProperties Int
  features      Json
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  accounts      Account[]
}

model SuperAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

// ─── Sub-Accounts (Landlords/Property Owners) ────────────────────────────────

model Account {
  id             String          @id @default(cuid())
  name           String
  ownerName      String
  email          String          @unique
  password       String
  phone          String?
  planId         String
  plan           Plan            @relation(fields: [planId], references: [id])
  isActive       Boolean         @default(true)
  trialEndsAt    DateTime?
  gcashNumber    String?
  mayaNumber     String?
  bankDetails    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  properties     Property[]
  users          User[]
  billingRecords BillingRecord[]
}

model User {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  email     String   @unique
  password  String
  name      String
  role      String   @default("STAFF")
  createdAt DateTime @default(now())
}

model Property {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  name          String
  address       String
  type          String
  description   String?
  amenities     Json?
  images        Json?
  isListed      Boolean  @default(false)
  listingStatus String   @default("unlisted")
  slug          String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  units         Unit[]
}

model Unit {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  unitNumber    String
  floor         String?
  rentAmount    Float
  depositAmount Float?
  status        String   @default("vacant")
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenants       Tenant[]
}

model Tenant {
  id               String               @id @default(cuid())
  unitId           String
  unit             Unit                 @relation(fields: [unitId], references: [id])
  name             String
  email            String?
  phone            String               @unique
  moveInDate       DateTime
  moveOutDate      DateTime?
  dueDay           Int                  @default(5)
  depositAmount    Float?
  depositPaid      Boolean              @default(false)
  portalPin        String
  isActive         Boolean              @default(true)
  emergencyContact String?
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  payments         Payment[]
  maintenanceRequests MaintenanceRequest[]
  reminders        Reminder[]
  notices          Notice[]
  ledger           MonthlyLedger[]
}

model Payment {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  amount          Float
  rentAmount      Float?
  electricAmount  Float?
  waterAmount     Float?
  month           String
  dueDate         DateTime
  paidDate        DateTime?
  status          String   @default("pending")
  proofUrl        String?
  method          String?
  notes           String?
  rejectedReason  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MaintenanceRequest {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  title       String
  description String
  priority    String    @default("normal")
  status      String    @default("open")
  images      Json?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Reminder {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  type      String
  trigger   String
  sentAt    DateTime @default(now())
  message   String
  status    String   @default("sent")
}

model Notice {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  accountId String
  title     String
  content   String
  type      String   @default("general")
  createdAt DateTime @default(now())
}

model ReminderConfig {
  id           String   @id @default(cuid())
  accountId    String   @unique
  smsEnabled   Boolean  @default(false)
  emailEnabled Boolean  @default(true)
  inAppEnabled Boolean  @default(true)
  daysBefore   Json     @default("[7, 3, 1]")
  daysAfter    Json     @default("[1, 3, 7]")
  updatedAt    DateTime @updatedAt
}

model MonthlyLedger {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month          String   // "YYYY-MM"

  rentAmount        Float
  rentPaidAmount    Float?
  rentPaid          Boolean  @default(false)

  electricAmount    Float?
  electricPaidAmount Float?
  electricPaid      Boolean  @default(false)

  waterAmount       Float?
  waterPaidAmount   Float?
  waterPaid         Boolean  @default(false)

  otherAmount       Float?
  otherPaidAmount   Float?
  otherLabel        String?
  otherPaid         Boolean  @default(false)

  balance           Float    @default(0)
  balancePaid       Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, month])
}

// ─── Security ─────────────────────────────────────────────────────────────────

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String // e.g. "landlord:email@example.com" or "tenant:+639..." or "signup:1.2.3.4"
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

model BillingRecord {
  id              String    @id @default(cuid())
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id])
  amount          Float
  period          String
  dueDate         DateTime
  status          String    @default("pending") // pending | submitted | paid | overdue
  referenceNumber String?
  proofUrl        String?
  paidAt          DateTime?
  reminderSentAt  DateTime?
  createdAt       DateTime  @default(now())
}

// Singleton row holding the platform's own GCash/Maya payment info, shown
// to landlords when they pay their subscription.
model PlatformSettings {
  id          String   @id @default(cuid())
  gcashNumber String?
  gcashQrUrl  String?
  mayaNumber  String?
  mayaQrUrl   String?
  updatedAt   DateTime @updatedAt
}
