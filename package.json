{
  "name": "rodja-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "dotenv -e .env -- npx tsx prisma/seed.ts",
    "hash-pins": "dotenv -e .env -- npx tsx prisma/hash-pins.ts",
